NODE_ENV=development
PORT=3000
HOST=127.0.0.1
COLLECT_INTERVAL_MINUTES=15
# Cross-platform public collectors are enabled by default; use COLLECT_CROSS_PLATFORM=false to disable.
COLLECT_CROSS_PLATFORM=true
RATE_LIMIT_PER_MINUTE=120
ADMIN_TOKEN=replace-with-a-long-random-token
GOOGLE_TRENDS_GEOS=IN,US,GB,CA,AU,DE,JP
NEWS_RSS_FEEDS=https://www.pcgamer.com/rss/,https://feeds.feedburner.com/ign/games,https://www.eurogamer.net/feed,https://www.videogameschronicle.com/feed/,https://www.gematsu.com/feed,https://www.polygon.com/rss/index.xml
HTTP_USER_AGENT=GamingIntelligencePlatform/0.2 (+https://example.com/contact)

# Connector switches
# Keyless built-in collectors default to enabled; set false to disable them.
STEAM_ENABLED=true
EPIC_ENABLED=true
XBOX_ENABLED=false
GAMEPASS_ENABLED=false
PLAYSTATION_ENABLED=false
PSPLUS_ENABLED=false
NINTENDO_ENABLED=false
UBISOFT_ENABLED=false
EA_ENABLED=false
BATTLENET_ENABLED=false
GOOGLE_PLAY_ENABLED=false
APPLE_STORE_ENABLED=false
EA_PLAY_ENABLED=false
UBISOFT_PLUS_ENABLED=false

# Microsoft/Xbox: use an authorized Microsoft Store service endpoint and access token.
# Do not put a consumer Microsoft password here.
MICROSOFT_STORE_ACCESS_TOKEN=
XBOX_CATALOG_URL=
GAMEPASS_CATALOG_URL=

# Other marketplaces: set only when you have an authorized/licensed provider endpoint.
PLAYSTATION_PROVIDER_URL=
PLAYSTATION_PROVIDER_KEY=
PSPLUS_PROVIDER_URL=
PSPLUS_PROVIDER_KEY=
NINTENDO_PROVIDER_URL=
NINTENDO_PROVIDER_KEY=
UBISOFT_PROVIDER_URL=
UBISOFT_PROVIDER_KEY=
EA_PROVIDER_URL=
EA_PROVIDER_KEY=
BATTLENET_PROVIDER_URL=
BATTLENET_PROVIDER_KEY=
GOOGLE_PLAY_PROVIDER_URL=
GOOGLE_PLAY_PROVIDER_KEY=
APPLE_STORE_PROVIDER_URL=
APPLE_STORE_PROVIDER_KEY=
EA_PLAY_PROVIDER_URL=
EA_PLAY_PROVIDER_KEY=
UBISOFT_PLUS_PROVIDER_URL=
UBISOFT_PLUS_PROVIDER_KEY=

# Key-free upcoming-game discovery from official public announcement pages.
# Add additional permitted public pages as comma-separated URLs if desired.
UPCOMING_SOURCES=

# Cross-platform public collectors are enabled by default. Set false to disable them.
COLLECT_CROSS_PLATFORM=true

# Master cross-platform catalog indexing
CATALOG_PAGES_PER_RUN=8
CATALOG_REGION=en-in
STEAM_WEB_API_KEY=
STEAM_CATALOG_MAX_RESULTS_PER_CALL=50000
STEAM_CATALOG_CALLS_PER_RUN=1
STEAM_PUBLIC_CATALOG_PAGES_PER_RUN=8
PLAYSTATION_CATALOG_PAGES_PER_RUN=8
XBOX_CATALOG_PAGES_PER_RUN=8
GOG_CATALOG_PAGES_PER_RUN=8
UBISOFT_CATALOG_PAGES_PER_RUN=8
EPIC_CATALOG_PAGES_PER_RUN=8
